-- Função para adicionar ID à API do ADN
local function addMusicToAPI(id)
    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or request
        if req then
            req({
                Url = API_URL,
                Method = "POST",
                Headers = {["Content-Type"]="application/json"},
                Body = HttpService:JSONEncode({id=tostring(id)})
            })
        end
    end)
end

local function addMusicObjToAPI(name, id)
    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or request
        if req then
            req({
                Url = API_URL_Obj,
                Method = "POST",
                Headers = {["Content-Type"]="application/json"},
                Body = HttpService:JSONEncode({name=name, Obj=tostring(id)})
            })
        end
    end)
end

