-- Fallback para Remotes conhecidos do Brookhaven
local function fireMusic(id)
    -- 1. Remote do ADN (Animal Simulator / outros jogos)
    if idmusicRemote then
        pcall(function() idmusicRemote:FireServer(tostring(id)) end)
    end
    -- 2. Remotes do Brookhaven (carro, casa, scooter, tool)
    pcall(function() ReplicatedStorage.RE.PlayerToolEvent:FireServer("ToolMusicText", tostring(id), true) end)
    pcall(function() ReplicatedStorage.RE:FindFirstChild("1NoMoto1rVehicle1s"):FireServer("PickingScooterMusicText", tostring(id)) end)
    pcall(function() ReplicatedStorage.RE:FindFirstChild("1Player1sCa1r"):FireServer("PickingCarMusicText", tostring(id)) end)
    pcall(function() ReplicatedStorage.RE:FindFirstChild("1Player1sHous1e"):FireServer("PickHouseMusicText", tostring(id)) end)
end

local function stopMusic()
    fireMusic("0")
    -- para som local também
    for _, s in pairs(SoundService:GetDescendants()) do
        if s:IsA("Sound") and s.Name == "AvenMusic" then
            s:Stop(); s:Destroy()
        end
    end
end

-- Som local (para o próprio jogador ouvir)
local currentLocalSound = nil
local function playLocal(id)
    if currentLocalSound then
        pcall(function() currentLocalSound:Stop(); currentLocalSound:Destroy() end)
    end
    local s = Instance.new("Sound")
    s.Name = "AvenMusic"
    s.SoundId = "rbxassetid://"..tostring(id)
    s.Volume = 0.5
    s.Looped = true
    s.Parent = SoundService
    s:Play()
    currentLocalSound = s
end

